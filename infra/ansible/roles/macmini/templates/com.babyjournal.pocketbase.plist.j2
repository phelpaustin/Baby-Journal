<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.babyjournal.pocketbase</string>
  <key>UserName</key><string>{{ bj_user }}</string>
  <key>ProgramArguments</key>
  <array><string>{{ bj_root }}/bin/bj-start-pocketbase.sh</string></array>
  <key>WorkingDirectory</key><string>{{ bj_root }}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BJ_ALERT_CMD</key><string>{{ bj_root }}/bin/bj-alert.sh</string>
    <!-- 0 = the daily trash purge only reports (dry run). Set to 1 after reviewing a few dry runs. -->
    <key>BJ_PURGE_ENABLE</key><string>{{ purge_enable }}</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <!-- Keep it running only while the SSD marker exists: with the SSD unplugged it stays stopped. -->
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key><dict><key>{{ data_marker }}</key><true/></dict>
  </dict>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardOutPath</key><string>{{ caddy_log_dir }}/pocketbase.log</string>
  <key>StandardErrorPath</key><string>{{ caddy_log_dir }}/pocketbase.log</string>
</dict>
</plist>
